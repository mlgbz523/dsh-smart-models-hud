{
  "name": "dsh-smart-models",
  "version": "0.1.0",
  "description": "DSH 独立智能模型聚合与置顶选择器：以模型名为主标题聚合多供应商，单行徽章就地切换渠道，支持常用模型星标置顶与最近使用历史。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-selector",
    "smart-models"
  ],
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json",
    "icon.svg",
    "README.md",
    "dashboard",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlgbz523/dsh-smart-models-hud.git"
  },
  "homepage": "https://github.com/mlgbz523/dsh-smart-models-hud#readme",
  "bugs": {
    "url": "https://github.com/mlgbz523/dsh-smart-models-hud/issues"
  },
  "scripts": {
    "prepack": "node scripts/verify-files.mjs"
  }
}
